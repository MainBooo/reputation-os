DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reputation_os
REDIS_URL=redis://localhost:6379
DEMO_MODE=true

# YandexGPT (sentiment для WEB-упоминаний + message classifier). apps/api/.env
# должен содержать ТЕ ЖЕ значения YANDEX_GPT_* — используются также для
# генерации AI-черновиков ответов (ai-reply-drafts.service.ts).
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite

# Message Classifier (TelegramMessageClassifierService) — routing thresholds.
TELEGRAM_AI_REVIEW_THRESHOLD=0.80
TELEGRAM_AI_HIDE_THRESHOLD=0.90
